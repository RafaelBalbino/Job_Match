<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tbPerfilAutonomo"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imgViewVoltar"
            android:layout_width="49dp"
            android:layout_height="62dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Botão Voltar"
            android:padding="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tbPerfilAutonomo"
            app:srcCompat="@drawable/ic_voltar_24"
            app:tint="?attr/colorOnPrimary" />

        <ImageView
            android:id="@+id/imgViewCompartilhar"
            android:layout_width="53dp"
            android:layout_height="62dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Botão Compartilhar Perfil"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tbPerfilAutonomo"
            app:srcCompat="@drawable/ic_compartilhar_24"
            app:tint="?attr/colorOnPrimary" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/LinhaGuiaCabecalho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.10" />

        <TextView
            android:id="@+id/txtViewNomeAutonomo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nome Perfil Autonomo"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/LinhaGuiaCabecalho" />

        <TextView
            android:id="@+id/txtViewTelefone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(99) 99999-9999"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtViewNomeAutonomo" />

        <TextView
            android:id="@+id/txtViewEndereco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtViewTelefone"
            tools:text="Cidade - Estado" />

        <FrameLayout
            android:id="@+id/frmLayoutPerfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtViewEndereco">

            <ImageView
                android:id="@+id/imgViewBG_Perfil"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Imagem de Fundo do Perfil"
                android:scaleType="centerCrop"
                android:background="?attr/colorSurfaceVariant" />

            <ImageView
                android:id="@+id/imgViewPerfil_Icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="Ícone de Perfil Padrão"
                app:tint="?attr/colorOnSurfaceVariant"
                android:alpha="0.8"
                app:srcCompat="@drawable/ic_usuario_padrao_24" />

        </FrameLayout>

        <Button
            android:id="@+id/btnCadastrarServico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="12dp"
            android:text="Cadastrar Serviço"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnEditarPerfil"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frmLayoutPerfil"
            app:layout_constraintWidth_max="250dp" />

        <Button
            android:id="@+id/btnEditarPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="24dp"
            android:text="Editar Perfil"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnCadastrarServico"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btnCadastrarServico"
            app:layout_constraintTop_toTopOf="@id/btnCadastrarServico"
            app:layout_constraintWidth_max="250dp" />

        <HorizontalScrollView
            android:id="@+id/HscrViewCategorias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:scrollbars="none"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnCadastrarServico">

            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/txtViewPopular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Popular"
                    android:textSize="18sp"
                    android:textColor="@color/branco"
                    android:background="@color/verde_agua"
                    android:textStyle="bold" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/txtViewServicos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Meus Serviços"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/HscrViewCategorias" />

        <TextView
            android:id="@+id/tv_sem_servicos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="30dp"
            android:text="Você ainda não cadastrou nenhum serviço."
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtViewServicos" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/containerServicos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtViewServicos"/>

        <LinearLayout
            android:id="@+id/botoes_pedidos_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/containerServicos"
            tools:layout_editor_absoluteX="24dp">

            <Button
                android:id="@+id/btn_buscar_pedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar Pedidos" />

            <Button
                android:id="@+id/btn_meus_projetos"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Meus Projetos" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>