<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".TelaMeuPerfil">

  <View
      android:id="@+id/view_background_header"
      android:layout_width="0dp"
      android:layout_height="296dp"
      android:background="#18B49D"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <Button
      android:id="@+id/btnVoltarPerfilAutonomo"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_marginTop="8dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="Botão pra voltar"
      app:icon="@drawable/ic_voltar_24"
      app:iconSize="25dp"
      app:iconTint="@color/secundaria_variante"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <ImageView
      android:id="@+id/img_foto_meu_perfil"
      android:layout_width="127dp"
      android:layout_height="117dp"
      android:layout_marginTop="60dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/circle_white"
      app:tint="#8E8E8E" />

  <TextView
      android:id="@+id/txt_nome_meu_perfil"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="Fulano de Tal"
      android:textColor="@color/branco"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/img_foto_meu_perfil" />

  <TextView
      android:id="@+id/txt_email_meu_perfil"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="fulanodetal@hotmail.com"
      android:textColor="@color/branco"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/txt_nome_meu_perfil" />

  <TextView
      android:id="@+id/lb_info_meu_perfil"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="40dp"
      android:text="Informações Pessoais"
      android:textColor="@color/preto"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/view_background_header" />

  <TextView
      android:id="@+id/txt_info_meu_perfil"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="4dp"
      android:text="Informações do seu documento de identidade e ocupação profissional."
      android:textColor="@color/cinza_escuro"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/lb_info_meu_perfil" />

  <View
      android:id="@+id/linearLayout1"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_marginTop="24dp"
      android:background="#18B49D"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/txt_info_meu_perfil" />

  <TextView
      android:id="@+id/lb_dados_meu_perfil"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="24dp"
      android:text="Dados das Contas"
      android:textColor="@color/preto"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/linearLayout1" />

  <TextView
      android:id="@+id/txt_dados_meu_perfil"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="4dp"
      android:text="Dados que representam a sua conta de usuário e sua conta freelancer."
      android:textColor="@color/cinza_escuro"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/lb_dados_meu_perfil" />

  <View
      android:id="@+id/linearLayout2"
      android:layout_width="0dp"
      android:layout_height="6dp"
      android:layout_marginTop="24dp"
      android:background="#18B49D"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/txt_dados_meu_perfil" />

  <TextView
      android:id="@+id/lb_seguranca_meu_perfil"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="24dp"
      android:text="Segurança"
      android:textColor="@color/preto"
      android:textSize="20sp"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

  <TextView
      android:id="@+id/txt_seguranca_meu_perfil"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="4dp"
      android:text="Métodos de verificação da sua conta e dispositivos vinculados a sua sessão."
      android:textColor="@color/cinza_escuro"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/lb_seguranca_meu_perfil" />

</androidx.constraintlayout.widget.ConstraintLayout>