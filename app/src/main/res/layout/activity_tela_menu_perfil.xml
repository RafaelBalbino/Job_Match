<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".TelaMenuPerfil">

    <!-- Botão de fechar (X) -->
    <ImageView
        android:id="@+id/btn_fechar_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#18B49D"
        android:contentDescription="Botão para fechar o menu" />

    <!-- Imagem de perfil -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_perfil_usuario"
        android:layout_width="76dp"
        android:layout_height="79dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Foto de perfil do usuário"
        app:civ_border_width="2dp"
        app:civ_border_color="#E0E0E0"
        tools:src="@tools:sample/avatars" />

    <!-- Nome do Usuário -->
    <TextView
        android:id="@+id/txt_nome_usuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Fulano de Tal"
        android:textColor="@color/preto"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btn_fechar_menu"
        app:layout_constraintStart_toEndOf="@+id/img_perfil_usuario"
        app:layout_constraintTop_toTopOf="@+id/img_perfil_usuario" />

    <!-- Email do Usuário -->
    <TextView
        android:id="@+id/txt_email_usuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="fulano.tal@gmail.com"
        android:textColor="@color/preto"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/btn_fechar_menu"
        app:layout_constraintStart_toEndOf="@+id/img_perfil_usuario"
        app:layout_constraintTop_toBottomOf="@+id/txt_nome_usuario" />

    <!-- Divisor do Cabeçalho -->
    <View
        android:id="@+id/divider_header_menu"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="24dp"
        android:background="#18B49D"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_perfil_usuario" />

    <!-- Container vertical para os itens do menu -->
    <LinearLayout
        android:id="@+id/container_opcoes_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_header_menu">

        <!-- Item 1: Meu Perfil -->
        <FrameLayout
            android:id="@+id/btn_meu_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:text="Meu Perfil"
                android:textColor="@color/preto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="#E0E0E0" />
        </FrameLayout>

        <!-- Item 2: Meus Pedidos -->
        <FrameLayout
            android:id="@+id/btn_meus_pedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:text="Meus Pedidos"
                android:textColor="@color/preto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="#E0E0E0" />
        </FrameLayout>

        <!-- Item 3: Projetos -->
        <FrameLayout
            android:id="@+id/btn_projetos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:text="Projetos"
                android:textColor="@color/preto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="#E0E0E0" />
        </FrameLayout>

        <!-- Item 4: Pagamentos -->
        <FrameLayout
            android:id="@+id/btn_pagamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:text="Pagamentos"
                android:textColor="@color/preto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="#E0E0E0" />
        </FrameLayout>

        <!-- Item 5: Configurações -->
        <FrameLayout
            android:id="@+id/btn_configuracoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:text="Configurações"
                android:textColor="@color/preto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="#E0E0E0" />
        </FrameLayout>

        <!-- Último Item: Encerrar Sessão (sem linha) -->
        <FrameLayout
            android:id="@+id/btn_encerrar_sessao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp"
                android:text="Encerrar Sessão"
                android:textColor="#C62828"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
