<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_servico_root"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="14dp"

    android:background="@drawable/card_border_background" > <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image_servico_fundo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cinza_claro"
        android:contentDescription="Imagem do Serviço"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/txtNomeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|top"
        android:gravity="center|top"
        android:text="Nome do Serviço"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgEditar"
        android:layout_width="68dp"
        android:layout_height="63dp"
        android:layout_gravity="right"
        android:background="@android:color/transparent"
        android:paddingRight="6dp"
        app:srcCompat="@drawable/ic_editar_24" />

    <LinearLayout
        android:id="@+id/layout_alerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgAlerta"
            android:layout_width="175dp"
            android:layout_height="185dp"

            android:layout_gravity="center_horizontal"
            android:paddingBottom="18dp"
            app:srcCompat="@drawable/ic_alerta_24" />

        <TextView
            android:id="@+id/text_abaixo_icone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center_horizontal"
            android:paddingBottom="12dp"
            android:text="Imagem Desconhecida"
            android:textSize="16sp" />

    </LinearLayout>
</FrameLayout>
</androidx.cardview.widget.CardView>