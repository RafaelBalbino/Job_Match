<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".TelaNegocioAutonomo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Guias para alinhar o conteúdo de forma limpa e responsiva -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="24dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="24dp" />

        <!-- Cabeçalho -->
        <ImageView
            android:id="@+id/btn_voltar_pesquisa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="Voltar"
            android:padding="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_voltar_24"
            app:tint="?attr/colorPrimary" />

        <!-- Seção de Perfil -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_autonomo_avatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            app:civ_border_color="?attr/colorPrimary"
            app:civ_border_width="2dp"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/btn_voltar_pesquisa"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/tv_nome_autonomo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toEndOf="@id/iv_autonomo_avatar"
            app:layout_constraintTop_toTopOf="@id/iv_autonomo_avatar"
            tools:text="Nome do Autônomo" />

        <!-- Seção de Avaliações -->
        <RatingBar
            android:id="@+id/rb_media_avaliacoes"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.1"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tv_nome_autonomo"
            app:layout_constraintTop_toBottomOf="@id/tv_nome_autonomo"
            tools:rating="4.5"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_numero_avaliacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/rb_media_avaliacoes"
            app:layout_constraintStart_toEndOf="@id/rb_media_avaliacoes"
            app:layout_constraintTop_toTopOf="@id/rb_media_avaliacoes"
            tools:text="(500)"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btn_ver_avaliacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Ver Avaliações"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/rb_media_avaliacoes"
            app:layout_constraintTop_toBottomOf="@id/rb_media_avaliacoes"
            tools:visibility="visible" />

        <!-- Seção de Contato -->
        <TextView
            android:id="@+id/tv_contato_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Contato"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/iv_autonomo_avatar" />

        <TextView
            android:id="@+id/tv_telefone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_phone_24"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tv_contato_label"
            app:layout_constraintEnd_toStartOf="@+id/btn_whatsapp"
            tools:text="(11) 99999-9999" />


        <!-- Seção de Endereço -->

        <ImageView
            android:id="@+id/btn_whatsapp"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir no WhatsApp"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_telefone"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintTop_toTopOf="@id/tv_telefone"
            app:layout_constraintVertical_bias="0.363"
            app:srcCompat="@drawable/ic_whatsapp_24" />

        <TextView
            android:id="@+id/tv_endereco_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Endereço"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tv_telefone" />

        <TextView
            android:id="@+id/tv_endereco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_location_on_24"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tv_endereco_label"
            tools:text="São Paulo - SP" />

        <!-- Linha Divisória -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?android:attr/listDivider"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tv_endereco" />

        <!-- Seção de Serviços -->
        <TextView
            android:id="@+id/tv_servicos_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Serviços Oferecidos"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <Spinner
            android:id="@+id/spinner_categorias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/tv_servicos_label"
            tools:visibility="visible" />

        <!-- Botão de Ação Principal -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_servicos_oferecidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_categorias"
            tools:itemCount="3"
            tools:listitem="@layout/item_servico_encontrado" />

        <Button
            android:id="@+id/btn_fazer_pedido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingVertical="12dp"
            android:text="Fazer Pedido"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/rv_servicos_oferecidos" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>