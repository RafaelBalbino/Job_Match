<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="16dp">

    <RadioGroup
        android:id="@+id/search_options_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/search_by_service_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Nome do serviço" />

        <RadioButton
            android:id="@+id/search_by_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoria do serviço" />

        <RadioButton
            android:id="@+id/search_by_freelancer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do autônomo" />
    </RadioGroup>

</LinearLayout>